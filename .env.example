# Environment Variables Template for GeoNexus V4
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these values from your Supabase project dashboard:
# Settings > API > Project URL and anon/public key

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# ============================================
# DATABASE AND API CONFIGURATION
# ============================================
DATABASE_URL=postgresql+asyncpg://geonexus_user:senha_segura@localhost:5432/geonexus_db
GOOGLE_CLOUD_PROJECT=seu-projeto-gcp
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service_account.json
JWT_SECRET_KEY=gere-uma-chave-com-alta-entropia
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000"]

# ============================================
# GOOGLE MAPS CONFIGURATION  
# ============================================
# Get your API key from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Enable: Maps SDK for Android, Maps SDK for iOS, Maps JavaScript API

GOOGLE_MAPS_API_KEY=SUA_CHAVE_GOOGLE_MAPS_AQUI
